# Used by `npm run dev`. Change these when the local API moves.

# API the browser calls while developing.
VITE_API_BASE_URL=http://127.0.0.1:4000

# Address and port of the Vite dev server.
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# Where the dev server forwards /api. Docker overrides this to http://api:4000.
API_PROXY_TARGET=http://127.0.0.1:4000
